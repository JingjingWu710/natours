{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "app.js",
  "scripts": {
    "start": "nodemon server.js",
    "start:prod": "set NODE_ENV=production&& nodemon server.js",
    "start:dev": "set NODE_ENV=development&& nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch ./public/js/index.js --out-dir ./public/js --out-file bundle.js --public-url .",
    "build:js": "parcel build ./public/js/index.js --out-dir ./public/js --out-file bundle.js --public-url ."
  },
  "author": "Jonas Schmedtmann",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.50.0",
    "dotenv": "^7.0.0",
    "express": "^4.16.4",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.15.2",
    "morgan": "^1.9.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "parcel-bundler": "^1.12.5",
    "pug": "^3.0.4",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "stripe": "^22.6.1",
    "validator": "^13.15.26",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "nodemon": "^3.1.10",
    "prettier": "^1.17.0"
  },
  "engines": {
    "node": ">=10.0.0"
  }
}
